{
  "name": "sufler",
  "version": "0.1.0",
  "description": "Środowisko pracy z Claude Code: edytor, terminale, panele skilli i MCP",
  "main": "out/main/index.js",
  "author": "Szymon Zielonka",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder --mac",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true,
    "node-pty": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3",
    "ws": "^8.21.3"
  }
}
